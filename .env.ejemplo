# ============================================================
# Plantilla de configuración
#
# Copie este archivo como .env y complete los valores.
# El archivo .env no se versiona: contiene credenciales.
# ============================================================

# ---------------- Base de datos (Supabase / PostgreSQL) ----------------
SUPABASE_URL=https://<proyecto>.supabase.co

# Clave pública, puede llegar al navegador
SUPABASE_PUBLISHABLE_KEY=

# Clave de servicio: SOLO backend, nunca exponer
SUPABASE_SECRET_KEY=

# Contraseña de la base (Project Settings > Database)
# Necesaria únicamente para crear el esquema
SUPABASE_DB_PASSWORD=

# Región del proyecto (Project Settings > General)
SUPABASE_REGION=aws-0-us-west-2

# ---------------- Servidor de aplicación ----------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True

# Clave para firmar los tokens de sesión
SECRET_KEY=cambiar-en-produccion

# ---------------- Correo para alertas (RF7) ----------------
# Sin SMTP_HOST definido, las notificaciones se registran como simuladas.
# Para demostración local: python backend/servidor_correo_prueba.py
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=kpi@horizonte.cl
SMTP_TLS=True
SMTP_SSL=False

DOMINIO_CORREO=horizonte.cl
CORREO_GERENCIA=gerencia.ti@horizonte.cl

# ---------------- Conector a Jira ----------------
# Sin estas variables, la carga de datos se realiza por archivo.
JIRA_URL=
JIRA_USUARIO=
JIRA_TOKEN=
JIRA_PROYECTO_CAMBIOS=
JIRA_PROYECTO_INCIDENTES=
JIRA_PROYECTO_REQUERIMIENTOS=
JIRA_PROYECTO_DEMANDA=
